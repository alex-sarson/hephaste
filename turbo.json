{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "jobs-runner": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "AUTH_MODE", "RESEND_API_KEY", "RESEND_FROM_EMAIL"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "AUTH_MODE"]
    },
    "generate": {
      "cache": false
    }
  }
}
