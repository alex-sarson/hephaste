# Copy to .env (repo root) for local dev — or just run `pnpm dev`, which does
# it for you on first run. Never commit the real .env.

# --- Database ---
# Owner/migration role — creates and owns every table (`pnpm db:migrate`),
# and is the connection apps/api/src/lib/db.ts's privilegedPrisma uses for
# genuinely cross-tenant system code (the overdue sweep, background-job
# queue processing). Never used for per-request tenant traffic — see
# APP_DATABASE_URL below and brief §7.
DATABASE_URL="postgresql://hephaste:hephaste@localhost:5432/hephaste"
# App runtime role — created by the add_row_level_security migration
# (packages/db/prisma/migrations/), NOT the table owner, so Postgres Row-
# Level Security actually applies to it. Every per-request DB query goes
# through this connection (see lib/db.ts's withTenantScope) — this is the
# role FORCE ROW LEVEL SECURITY is the real backstop against.
APP_DATABASE_URL="postgresql://hephaste_app:hephaste_app@localhost:5432/hephaste"

# Admin console role — created by the add_admin_role migration. BYPASSRLS so
# it can count across accounts, but granted only metadata columns (no customer/
# job/invoice content), so it can't read what admins aren't meant to see. Only
# apps/api/src/modules/admin uses it (lib/db.ts adminPrisma()).
ADMIN_DATABASE_URL="postgresql://hephaste_admin:hephaste_admin@localhost:5432/hephaste"

# --- Auth (Clerk) — tenant-facing app, see brief §7 ---
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Local dev-only auth bypass (see apps/api/src/lib/devAuth.ts) ---
# Set both to "dev" to test the app without a real Clerk account: the API
# auto-provisions a single stub Account/Admin and skips token verification;
# the web app skips ClerkProvider and renders as already signed in. Refuses
# to activate if NODE_ENV=production. Leave unset for real Clerk auth.
AUTH_MODE=
VITE_AUTH_MODE=

# --- Email (Resend), see brief §9 ---
RESEND_API_KEY=
# From Resend's webhook setup screen — used to verify the Svix-signed
# inbound webhook at POST /api/webhooks/resend (see modules/email/webhooks.ts).
RESEND_WEBHOOK_SECRET=
# Must be on a domain verified in Resend to send outside sandbox mode.
# Leave unset to use Resend's own onboarding@resend.dev sandbox sender,
# which only delivers to the email on your own Resend account.
RESEND_FROM_EMAIL=

# --- Object storage (Cloudflare R2 in prod, SeaweedFS locally), see brief §12 ---
# `pnpm dev` starts a local SeaweedFS on this port if nothing is listening
# there yet, seeding this identity and bucket. Any S3-compatible server works.
S3_ENDPOINT="http://localhost:8333"
S3_ACCESS_KEY_ID=hephaste
S3_SECRET_ACCESS_KEY=hephaste-dev-secret
S3_BUCKET=hephaste-dev

# --- API ---
PORT=3001
VITE_API_URL="http://localhost:3001"
