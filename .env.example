# Copy to .env (repo root) for local dev. Never commit the real .env.

# --- Database ---
DATABASE_URL="postgresql://trade_platform:trade_platform@localhost:5432/trade_platform"

# --- Auth (Clerk) — tenant-facing app, see brief §7 ---
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Auth (Clerk) — separate admin instance/app, see brief §5.3 ---
CLERK_ADMIN_SECRET_KEY=

# --- Email (Postmark), see brief §9 ---
POSTMARK_SERVER_TOKEN=
POSTMARK_WEBHOOK_BASIC_AUTH="webhook_user:change_me"

# --- Object storage (Cloudflare R2 in prod, MinIO locally), see brief §12 ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=trade-platform-dev

# --- API ---
PORT=3001
VITE_API_URL="http://localhost:3001"
